# Dependencies — every sub-project
**/node_modules/

# Build output
**/dist/
**/out-tsc/
**/.angular/

# Vite / TypeScript cache
**/.vite/
**/*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# pnpm locks are committed for release compatibility verification.
# Other package-manager locks remain local to avoid conflicting resolutions.
**/package-lock.json
**/yarn.lock

# Environment & secrets (never commit tokens)
.env
.env.*

# OS artefacts
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Angular CLI leftovers
/tmp/
/coverage/
/e2e/test-output/
