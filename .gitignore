# Dependencies — every sub-project
**/node_modules/

# Build output
**/dist/
**/out-tsc/
**/.angular/

# Vite / TypeScript cache
**/.vite/
**/*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Lock files (each sub-project manages its own)
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml

# Environment & secrets (never commit tokens)
.env
.env.*
.npmrc

# OS artefacts
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Angular CLI leftovers
/tmp/
/coverage/
/e2e/test-output/
